# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.test-artifacts/
# Local audit fixtures and logs, including nested temporary Git repositories.
/orchestrator/.pytest-*/
/orchestrator/.pytest-*.txt
/orchestrator/.audit-*/
/orchestrator/.*-audit.txt
.coverage
htmlcov/

# uv
uv.lock

# AgentKit state. Runtime state is never committed (PLAN_V3.md §4.1: exactly
# one authority per fact). AgentKit is not developed through itself, so this
# repository's own .ai/ folder stays out of Git; the patterns below also cover
# .ai/ folders inside local test fixtures.
/.ai/
.ai/tasks.db
.ai/tasks.db-wal
.ai/tasks.db-shm
.ai/runtime/
.ai/capabilities.json
.ai/githooks/
.ai/env-fingerprint

# Worker worktrees live beside the repo, but guard against stray ones inside it
wt-*/

