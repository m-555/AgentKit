# (.ai/tasks.yaml, .ai/project.yaml, .ai/jobs/) also stays local.
/.ai/
.ai/tasks.db
.ai/tasks.db-wal
.ai/tasks.db-shm
.ai/runtime/
.ai/capabilities.json
.ai/githooks/
.ai/env-fingerprint

# Worker worktrees live beside the repo, but guard against stray ones inside it
wt-*/

