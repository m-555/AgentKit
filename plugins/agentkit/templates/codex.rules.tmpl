# AgentKit execpolicy for Codex — copy to <repo>/.codex/project.rules
#
# Starlark rules gating which commands run without approval. This is Codex's
# deterministic layer, equivalent to Claude Code's permissions.allow/deny.
#
# Same shape as the entries in ~/.codex/rules/default.rules.

# --- read-only inspection: always safe -------------------------------------
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")

# --- committing inside a worktree is expected of every worker --------------
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")

# --- never let a worker publish or merge -----------------------------------
# Merges and pushes belong to the integrator, driven explicitly.
prefix_rule(pattern=["git", "push"], decision="deny")
prefix_rule(pattern=["git", "merge"], decision="deny")
prefix_rule(pattern=["git", "rebase"], decision="deny")
prefix_rule(pattern=["git", "reset", "--hard"], decision="deny")
prefix_rule(pattern=["git", "checkout", "main"], decision="deny")

